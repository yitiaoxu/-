                    <data>set_clock_uncertainty {0.200} [get_clocks {cmos1_pclk}]  -setup -hold</data>
                </row>
                <row>
                    <data>set_clock_uncertainty {0.200} [get_clocks {cmos2_pclk}]  -setup -hold</data>
                </row>
                <row>
                    <data>set_clock_uncertainty 0.400 [get_clocks {cmos2_pclk}] -setup -hold</data>
                </row>
                <row>
                    <data>set_multicycle_path 2 -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_0}]</data>
                </row>
                <row>
                    <data>set_multicycle_path -hold 1 -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_0}]</data>
                </row>
                <row>
                    <data>set_multicycle_path 2 -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_1}]</data>
                </row>
                <row>
                    <data>set_multicycle_path -hold 1 -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_1}]</data>
                </row>
                <row>
                    <data>set_false_path -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {clk_50m}]</data>
                </row>
            </table>
        </table_container>
        <table_container>
            <table id="device_map_timing_constraint" title="Inferred clocks commands" column_number="1">
                <column_headers>
                    <data>Command</data>
                </column_headers>
                <row>
                    <data>create_generated_clock -name {cmos2_pclk|cmos2_8_16bit/u_GTP_IOCLKDIV/CLKDIVOUT_Inferred} -master_clock {cmos2_pclk} -source [get_ports {cmos2_pclk}] -edges {1 2 3} -edge_shift {0.000000 5.950000 11.900000} [get_pins {cmos2_8_16bit/u_GTP_IOCLKDIV.CLKDIVOUT}] -add</data>
                </row>
            </table>
        </table_container>
