    )
    (_task tsk_pnr
        (_command cmd_pnr
            (_gci_state (_integer 2))
            (_db_output
                (_file "place_route/image_pcie_capture_pnr.adf"
                    (_format adif)
                    (_timespec "2026-07-13T01:42:26")
                )
            )
            (_output
                (_file "place_route/clock_utilization.txt"
                    (_format text)
                    (_timespec "2026-07-13T01:42:15")
                )
                (_file "place_route/image_pcie_capture_plc.adf"
                    (_format adif)
                    (_timespec "2026-07-13T01:41:16")
                )
                (_file "place_route/image_pcie_capture.prr"
                    (_format text)
                    (_timespec "2026-07-13T01:42:26")
                )
                (_file "place_route/image_pcie_capture_prr.prt"
                    (_format text)
                    (_timespec "2026-07-13T01:42:15")
                )
                (_file "place_route/ConvertedNetInDynamicDrivenPreRouter.txt"
                    (_format text)
                    (_timespec "2026-07-13T01:41:25")
                )
                (_file "place_route/ConvertedNetInStaticDrivenNetPreRouter.txt"
                    (_format text)
                    (_timespec "2026-07-13T01:41:25")
                )
                (_file "place_route/CRouteDesignNetList.txt"
                    (_format text)
                    (_timespec "2026-07-13T01:41:23")
                )
                (_file "place_route/partition_pin_info.txt"
                    (_format text)
                    (_timespec "2026-07-13T01:42:09")
                )
                (_file "place_route/image_pcie_capture_pnr.netlist"
                    (_format text)
                    (_timespec "2026-07-13T01:42:26")
                )
                (_file "place_route/prr.db"
                    (_format text)
                    (_timespec "2026-07-13T01:42:26")
                )
            )
        )
        (_widget wgt_power_calculator
            (_attribute _click_to_run (_switch ON))
        )
        (_widget wgt_timing_analysis
            (_attribute _click_to_run (_switch ON))
        )
        (_command cmd_report_post_pnr_timing
            (_gci_state (_integer 0))
            (_attribute _auto_exe_lock (_switch OFF))
        )
        (_widget wgt_arch_browser
            (_attribute _click_to_run (_switch ON))
        )
        (_command cmd_report_power
            (_gci_state (_integer 0))
            (_attribute _auto_exe_lock (_switch OFF))
            (_attribute _auto_exe (_switch OFF))
        )
        (_command cmd_gen_netlist
            (_gci_state (_integer 0))
            (_attribute _auto_exe_lock (_switch OFF))
            (_attribute _auto_exe (_switch OFF))
        )
    )
    (_task tsk_gen_bitstream
        (_command cmd_gen_bitstream
            (_gci_state (_integer 0))
            (_option compress_bitstream (_boolean TRUE))
            (_option master_configuration_clock_frequency (_string "40M"))
        )
    )
)
